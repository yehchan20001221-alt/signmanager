<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SignLibraryAspNet</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="App_Data\**\*;SourceAssets\**\*" />
    <None Remove="App_Data\**\*;SourceAssets\**\*" />
    <Content Include="App_Data\**\*;SourceAssets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
